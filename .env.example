# =============================================================================
# Tozsde Trading System – Környezeti változók sablonja
# Másold ezt a fájlt .env névvel és töltsd ki a valódi értékekkel.
# SOHA ne commitolj .env fájlt valódi titkokkal!
# =============================================================================

# --- Általános pipeline ---
DRY_RUN=false
# DEBUG | INFO | WARNING | ERROR
LOGGING_LEVEL=INFO

# --- Execution ---
EXECUTION_MODE=paper
# BROKER_ADAPTER=noop               # noop (default) | alpaca (szükséges: pip install alpaca-trade-api)
# BROKER_API_KEY=                   # Alpaca API kulcs
# BROKER_API_SECRET=                # Alpaca API titkos kulcs
# BROKER_BASE_URL=https://paper-api.alpaca.markets
# BROKER_PAPER=true
# next_open | close_to_close
EXECUTION_POLICY=next_open

# --- Tőke és kockázat ---
# Kezdőtőke (USD)
INITIAL_CAPITAL=10000
# Kockázat per trade (2% = 0.02)
RISK=0.02
# Tranzakciós díj (0.1% = 0.001)
TRANSACTION_FEE_PCT=0.001
# Minimális slippage
MIN_SLIPPAGE_PCT=0.0005
# Bid-ask spread becslés
SPREAD_PCT=0.0005

# --- Drawdown védelem ---
ENABLE_DRAWDOWN_GUARD=false
# 10% drawdown -> circuit breaker
DRAWDOWN_HALT_PCT=0.10

# --- RL modell ---
# true: monthly pipeline RL retraining
ENABLE_RL=false
RL_TRAINING_MODE=false
RL_TIME_SPLIT_ENABLED=true
RL_TRAIN_RATIO=0.7
RL_VAL_RATIO=0.15
# RL_TRAIN_END_DATE=                # opcionális, pl. 2024-12-31
# RL_VAL_END_DATE=                  # opcionális
# RL_TEST_END_DATE=                 # opcionális

# --- Walk-forward és governance ---
# Minimális out-of-sample Sharpe küszöb
MIN_OOS_SHARPE=0.4
# Max IS/OOS gap (overfitting szűrő)
MAX_RELATIVE_GAP=0.4
# true: részletes pipeline audit JSON
PIPELINE_AUDIT_MODE=false
EDGE_DIAGNOSTICS_MODE=false

# --- Reliability scoring (weekly) ---
# true: weekly reliability scoring
ENABLE_RELIABILITY=false
# db | file
RELIABILITY_SOURCE=db
RELIABILITY_PERIOD_DAYS=30

# --- Confidence kalibráció ---
ENABLE_CONFIDENCE_CALIBRATION=false

# --- Drift detekció ---
ENABLE_DRIFT_DETECTION=true

# --- Execution stress testing ---
ENABLE_EXECUTION_STRESS=true

# --- Aggregáció ---
# latest_only | all
AGGREGATION_MODE=latest_only

# --- Fallback ---
ALLOW_NO_MODEL_FALLBACK=true

# --- Flask admin API ---
ENABLE_FLASK=false
# WARNING: Kötelező felülírni production-ban!
ADMIN_API_KEY=CHANGE_ME_IN_PRODUCTION
# WARNING: Kötelező felülírni production-ban!
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# --- Email értesítések ---
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
# NOTIFY_EMAIL=recipient@example.com
EMAIL_MAX_BODY_CHARS=5000
EMAIL_MAX_DETAIL_LINES=20
